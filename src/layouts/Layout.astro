---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Nicolle Weeks | Content design, conversational AI, and AI literacy for working professionals',
  description = 'Content design, conversational AI, and AI literacy by Nicolle Weeks. 20+ years across journalism, financial services, and digital product. Toronto-based.',
} = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolle Weeks',
  url: 'https://nicolleweeks.ca/',
  image: 'https://nicolleweeks.ca/images/headshot.jpg',
  jobTitle: 'Writer',
  description:
    "Nicolle Weeks writes and works on AI literacy for working professionals. A Toronto-based writer with 20+ years across journalism, content marketing, and financial-services product, she led content design on Scotiabank's conversational assistant, a pre-LLM AI experience that resolved 85% of customer inquiries without escalation and earned the 2023 Digital Transformation Award. She built the Scotia Digital Style Guide, scaled a content design team across five business lines, and now runs Trustfall, a studio helping small businesses ship brand, web, and content work that earns trust. Through her Substack Human+AI, she writes for the people AI is changing the workday for: managers, individual contributors, and operators in regulated industries who need clear, honest answers about how to use these tools well.",
  worksFor: [
    { '@type': 'Organization', name: 'Manulife', url: 'https://www.manulife.com/' },
    { '@type': 'Organization', name: 'Trustfall', url: 'https://trustfall.ca/' },
  ],
  knowsAbout: [
    'Marketing and content strategy for small businesses',
    'Content design for financial services',
    'AI literacy for working professionals',
    'Building and scaling content design teams',
    'Design systems and content governance',
  ],
  sameAs: [
    'https://www.linkedin.com/in/nicolle/',
    'https://nicolleweeks.substack.com/',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Toronto',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
};

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nicolleweeks.ca/" />
    <link rel="canonical" href={`https://nicolleweeks.ca${Astro.url.pathname}`} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <div class="site-footer-brand">
          <span class="site-footer-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <rect x="4" y="6" width="3" height="20" fill="#FFB3D2" />
              <rect x="11" y="6" width="3" height="20" fill="#FFB3D2" />
              <rect x="18" y="6" width="3" height="20" fill="#FFB3D2" />
              <rect x="25" y="6" width="3" height="20" fill="#FFB3D2" />
            </svg>
          </span>
          <span>Nicolle Weeks</span>
        </div>
        <nav class="site-footer-nav" aria-label="Footer">
          <a href="/">Home</a>
          <a href="/work/">Work</a>
          <a href="/writing/">Writing</a>
          <a href="/#contact">Contact</a>
        </nav>
        <div class="site-footer-socials">
          <a href="https://www.linkedin.com/in/nicolle/" aria-label="LinkedIn, opens in a new tab" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.2 8h4.6v14H.2V8zm7.4 0h4.4v2h.07c.61-1.16 2.11-2.38 4.34-2.38 4.64 0 5.5 3.06 5.5 7.03V22h-4.6v-6.27c0-1.5-.03-3.43-2.09-3.43-2.09 0-2.41 1.63-2.41 3.32V22H7.6V8z"/></svg>
          </a>
          <a href="https://nicolleweeks.substack.com/" aria-label="Substack, opens in a new tab" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
          </a>
        </div>
        <p class="site-footer-meta">© {new Date().getFullYear()} Nicolle Weeks. Built in Toronto.</p>
      </div>
    </footer>
  </body>
</html>
