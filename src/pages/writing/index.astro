---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('writing', ({ data }) => !data.unlisted)).sort((a, b) => {
  const da = a.data.pubDate?.valueOf() ?? 0;
  const db = b.data.pubDate?.valueOf() ?? 0;
  return db - da;
});

const featured = all.filter((p) => p.data.featured);
const [lead, ...secondary] = featured;
const featuredSlugs = new Set(featured.map((p) => p.slug));
const rest = all.filter((p) => !featuredSlugs.has(p.slug));

const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---

<Layout title="Writing — Nicolle Weeks" description="Selected stories, profiles, and essays by Nicolle Weeks — on AI literacy, content design, and the work behind the work.">
  <nav class="nav nav--solid">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <rect x="4" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="11" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="18" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="25" y="6" width="3" height="20" fill="#FFB3D2" />
        </svg>
      </span>
      <span>Nicolle<br />Weeks</span>
    </a>
    <div class="nav-right">
      <a href="/about/" class="nav-link">About</a>
      <a href="/work/" class="nav-link">Work</a>
      <a href="/writing/" class="nav-link" aria-current="page">Writing</a>
      <a href="/#contact" class="btn btn-yellow">Let's collaborate</a>
    </div>
  </nav>

  <header class="mag-header">
    <div class="wrap">
      <p class="mag-eyebrow">Writing</p>
      <h1>Stories, profiles & essays from twenty years on the beat.</h1>
    </div>
  </header>

  {lead && (
    <section class="mag-lead">
      <a href={`/writing/${lead.slug}/`} class="mag-lead-link">
        {lead.data.heroImage && (
          <img src={lead.data.heroImage} alt="" class="mag-lead-img" loading="eager" />
        )}
        <div class="mag-lead-text">
          {lead.data.kicker && <p class="mag-kicker">{lead.data.kicker}</p>}
          <h2 class="mag-lead-title">{lead.data.title}</h2>
          {lead.data.description && <p class="mag-lead-stand">{lead.data.description}</p>}
          <p class="mag-byline">By Nicolle Weeks · {fmt(lead.data.pubDate)}</p>
        </div>
      </a>
    </section>
  )}

  {secondary.length > 0 && (
    <section class="mag-secondary">
      <div class="wrap">
        <div class="mag-secondary-grid">
          {secondary.map((p) => (
            <a href={`/writing/${p.slug}/`} class="mag-card">
              {p.data.heroImage && (
                <img src={p.data.heroImage} alt="" class="mag-card-img" loading="lazy" />
              )}
              {p.data.kicker && <p class="mag-kicker">{p.data.kicker}</p>}
              <h3 class="mag-card-title">{p.data.title}</h3>
              {p.data.description && <p class="mag-card-stand">{p.data.description}</p>}
              <p class="mag-byline">By Nicolle Weeks · {fmt(p.data.pubDate)}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="writing-list">
    <div class="wrap">
      <p class="mag-section-label">More writing</p>
      <ul>
        {rest.map((post) => (
          <li>
            <a href={`/writing/${post.slug}/`}>
              {post.data.heroImage ? (
                <img class="writing-thumb" src={post.data.heroImage} alt="" loading="lazy" />
              ) : (
                <span class="writing-thumb writing-thumb--empty" aria-hidden="true"></span>
              )}
              <div class="writing-meta">
                <time>{fmt(post.data.pubDate)}</time>
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
