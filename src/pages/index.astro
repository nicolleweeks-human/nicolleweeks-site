---
import Layout from '../layouts/Layout.astro';

const services = [
  { name: 'Brand strategy', icon: 'brand' },
  { name: 'Website design & build', icon: 'web' },
  { name: 'Content strategy', icon: 'content' },
  { name: 'Social & email', icon: 'social' },
  { name: 'Editorial & storytelling', icon: 'edit' },
  { name: 'AI enablement', icon: 'ai' },
];

const cases = [
  {
    variant: 'yellow',
    title: 'Scotiabank conversational assistant',
    sub: 'Content design × Trust',
    brief:
      "Chat was Scotiabank's #1 requested mobile feature. The team needed an assistant that could handle high-stakes tasks like password resets and credit card disputes — without eroding user trust or running afoul of legal, compliance, and accessibility.",
    execution:
      "As lead content designer, I authored 25+ flows, built a reusable conversation system, and aligned five review teams. Result: 85% of inquiries resolved without escalation and a 30% drop in contact-centre volume. Recognized with a 2023 Digital Transformation Award.",
  },
  {
    variant: 'pink',
    title: 'Scotia Digital Style Guide',
    sub: 'Design system × Governance',
    brief:
      "Product, comms, and ops teams across Scotiabank were each writing in their own voice. CTAs conflicted, tone drifted, and every project burned cycles re-litigating the basics.",
    execution:
      "I built the Scotia Digital Style Guide — a centralized library of CTAs, tone principles, and UI patterns — and stood up a Content Community of Practice across five business lines to keep it alive. Faster production, fewer rewrites, one voice.",
  },
  {
    variant: 'green',
    title: "Sarah McLachlan's School of Music",
    sub: 'CBC Music × Sun Life',
    brief:
      "Sun Life wanted a sponsorship that meant something. CBC Music had an audience but needed a story worth telling. The opportunity: connect a beloved Canadian artist to underserved kids who were being gifted donated musical instruments.",
    execution:
      "I led the content for a multi-platform campaign — website, video series, and branded content rolled out through CBC's national music outlets. The work won a 2016 SMCC Sponsorship Marketing Award.",
  },
];

const awards = [
  { title: 'Digital Transformation Award', org: 'IT World Canada', year: 2023 },
  { title: 'Best of the Best Award', org: 'Scotiabank', year: 2022 },
  { title: 'Employee Communications Award', org: 'Ragan', year: 2022 },
  { title: 'Sponsorship Marketing Award', org: 'SMCC', year: 2016 },
  { title: 'W³ Websites: Entertainment', org: 'W3 Awards', year: 2011 },
];
---

<Layout>
  <!-- NAV -->
  <nav class="nav">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <rect x="4" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="11" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="18" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="25" y="6" width="3" height="20" fill="#FFB3D2" />
        </svg>
      </span>
      <span>Nicolle<br />Weeks</span>
    </a>
    <div class="nav-right">
      <a href="/about/" class="nav-link">About</a>
      <a href="/work/" class="nav-link">Work</a>
      <a href="/writing/" class="nav-link">Writing</a>
      <a href="#contact" class="btn btn-yellow">Let's collaborate</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <h1>Award-winning marketing, digital and content strategist</h1>
    </div>
    <div class="hero-shapes" aria-hidden="true">
      <img src="/images/ribbon-1.png" alt="" />
      <img src="/images/ribbon-2.png" alt="" />
      <img src="/images/ribbon-3.png" alt="" />
      <img src="/images/ribbon-4.png" alt="" />
      <img src="/images/ribbon-1.png" alt="" />
      <img src="/images/ribbon-2.png" alt="" />
      <img src="/images/ribbon-3.png" alt="" />
      <img src="/images/ribbon-4.png" alt="" />
      <img src="/images/ribbon-1.png" alt="" />
      <img src="/images/ribbon-2.png" alt="" />
      <img src="/images/ribbon-3.png" alt="" />
      <img src="/images/ribbon-4.png" alt="" />
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-text">
          <h2>About me</h2>
          <p>
            I'm a Toronto-based strategist with 20+ years across journalism, content marketing, and content design — building digital experiences for national broadcasters, financial brands, and the people who actually use them.
          </p>
          <p>
            Today I run <strong>Trustfall</strong>, a studio that helps small businesses sound like themselves and ship work that earns trust. I also write <a href="https://nicolleweeks.substack.com/" style="color: #F4C842; border-bottom: 2px solid #F4C842;">Human+AI</a>, a Substack on AI literacy for working professionals.
          </p>
        </div>
        <div class="about-photo">
          <img src="/images/headshot.jpg" alt="Nicolle Weeks" width="420" />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services section">
    <div class="wrap">
      <h2>Services</h2>
      <div class="services-grid">
        {services.map((s) => (
          <div class="service">
            <svg class="service-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              {s.icon === 'brand' && (
                <g><circle cx="24" cy="24" r="6" fill="currentColor" /><circle cx="24" cy="10" r="4" fill="currentColor" /><circle cx="24" cy="38" r="4" fill="currentColor" /><circle cx="10" cy="24" r="4" fill="currentColor" /><circle cx="38" cy="24" r="4" fill="currentColor" /></g>
              )}
              {s.icon === 'web' && (
                <g><rect x="6" y="10" width="36" height="28" rx="3" stroke="currentColor" stroke-width="3" /><path d="M6 18 H42" stroke="currentColor" stroke-width="3" /><circle cx="11" cy="14" r="1.4" fill="currentColor" /><circle cx="15" cy="14" r="1.4" fill="currentColor" /></g>
              )}
              {s.icon === 'content' && (
                <g><path d="M24 6 L42 24 L24 42 L6 24 Z" stroke="currentColor" stroke-width="3" fill="none" /><circle cx="24" cy="24" r="4" fill="currentColor" /></g>
              )}
              {s.icon === 'social' && (
                <g><circle cx="14" cy="14" r="5" stroke="currentColor" stroke-width="3" fill="none" /><circle cx="34" cy="14" r="5" stroke="currentColor" stroke-width="3" fill="none" /><circle cx="24" cy="34" r="5" stroke="currentColor" stroke-width="3" fill="none" /><path d="M16 18 L22 30 M32 18 L26 30" stroke="currentColor" stroke-width="3" /></g>
              )}
              {s.icon === 'edit' && (
                <g><path d="M10 38 L10 30 L30 10 L38 18 L18 38 Z" stroke="currentColor" stroke-width="3" fill="none" /><path d="M26 14 L34 22" stroke="currentColor" stroke-width="3" /></g>
              )}
              {s.icon === 'ai' && (
                <g><rect x="10" y="14" width="28" height="22" rx="4" stroke="currentColor" stroke-width="3" fill="none" /><circle cx="18" cy="25" r="2" fill="currentColor" /><circle cx="30" cy="25" r="2" fill="currentColor" /><path d="M24 10 V14 M16 8 L18 14 M32 8 L30 14" stroke="currentColor" stroke-width="3" /></g>
              )}
            </svg>
            <span>{s.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASES -->
  <section class="cases">
    {cases.map((c) => (
      <article class={`case case--${c.variant}`}>
        <div class="case-text">
          <p class="case-eyebrow">{c.sub}</p>
          <h3>{c.title}</h3>
          <h4>The brief</h4>
          <p>{c.brief}</p>
          <h4>The execution</h4>
          <p>{c.execution}</p>
        </div>
        <div class="case-image">
          <svg class="case-art" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            {c.variant === 'yellow' && (
              <g>
                <rect x="60" y="80" width="280" height="240" rx="8" fill="#5C0E1B" />
                <rect x="60" y="80" width="280" height="38" rx="8" fill="#3F0712" />
                <circle cx="78" cy="99" r="4" fill="#FFB3D2" />
                <circle cx="92" cy="99" r="4" fill="#F4C842" />
                <circle cx="106" cy="99" r="4" fill="#F8F4EC" />
                <rect x="80" y="140" width="180" height="14" rx="7" fill="#FFB3D2" />
                <rect x="80" y="166" width="140" height="10" rx="5" fill="#F8F4EC" opacity="0.7" />
                <rect x="80" y="200" width="240" height="60" rx="6" fill="#F4C842" />
                <rect x="96" y="220" width="120" height="10" rx="5" fill="#5C0E1B" />
                <rect x="96" y="238" width="80" height="8" rx="4" fill="#5C0E1B" opacity="0.6" />
                <rect x="80" y="278" width="100" height="28" rx="14" fill="#FFB3D2" />
              </g>
            )}
            {c.variant === 'pink' && (
              <g>
                <rect x="40" y="60" width="140" height="280" rx="6" fill="#5C0E1B" />
                <rect x="200" y="60" width="160" height="135" rx="6" fill="#004F54" />
                <rect x="200" y="205" width="160" height="135" rx="6" fill="#5C0E1B" />
                <rect x="60" y="84" width="100" height="10" rx="5" fill="#FFB3D2" />
                <rect x="60" y="104" width="70" height="8" rx="4" fill="#F8F4EC" opacity="0.6" />
                <rect x="60" y="138" width="100" height="8" rx="4" fill="#F8F4EC" opacity="0.5" />
                <rect x="60" y="156" width="80" height="8" rx="4" fill="#F8F4EC" opacity="0.5" />
                <rect x="60" y="174" width="100" height="8" rx="4" fill="#F8F4EC" opacity="0.5" />
                <rect x="60" y="192" width="60" height="8" rx="4" fill="#F8F4EC" opacity="0.5" />
                <circle cx="280" cy="127" r="34" fill="#F4C842" />
                <rect x="220" y="240" width="120" height="8" rx="4" fill="#F8F4EC" />
                <rect x="220" y="258" width="90" height="8" rx="4" fill="#F8F4EC" opacity="0.7" />
                <rect x="220" y="290" width="60" height="24" rx="12" fill="#FFB3D2" />
              </g>
            )}
            {c.variant === 'green' && (
              <g>
                <circle cx="200" cy="200" r="150" fill="#5C0E1B" />
                <circle cx="200" cy="200" r="100" fill="#F4C842" />
                <circle cx="200" cy="200" r="50" fill="#FFB3D2" />
                <rect x="40" y="195" width="320" height="10" fill="#F8F4EC" opacity="0.85" />
                <rect x="195" y="40" width="10" height="320" fill="#F8F4EC" opacity="0.85" />
              </g>
            )}
          </svg>
        </div>
      </article>
    ))}
  </section>

  <!-- AWARDS -->
  <section class="awards section">
    <div class="wrap">
      <h2>Awards</h2>
      <div class="awards-grid">
        {awards.map((a) => (
          <div class="award">
            <svg class="award-icon" viewBox="0 0 56 56" fill="none" aria-hidden="true">
              <circle cx="28" cy="22" r="14" stroke="currentColor" stroke-width="3" fill="none" />
              <path d="M20 32 L16 50 L28 44 L40 50 L36 32" stroke="currentColor" stroke-width="3" fill="none" stroke-linejoin="round" />
              <circle cx="28" cy="22" r="5" fill="currentColor" />
            </svg>
            <div class="award-text">
              <strong>{a.title}</strong>
              {a.org} ({a.year})
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact section" id="contact">
    <div class="wrap">
      <div class="contact-grid">
        <div>
          <h2>Talk to me</h2>
          <p class="contact-info">
            <a href="mailto:hello@trustfall.ca">hello@trustfall.ca</a>
          </p>
          <p class="contact-meta">Based in Toronto, available universe wide.</p>
        </div>
        <div class="contact-bars" aria-hidden="true">
          <span style="height: 30%"></span>
          <span style="height: 45%"></span>
          <span style="height: 55%"></span>
          <span style="height: 65%"></span>
          <span style="height: 72%"></span>
          <span style="height: 80%"></span>
          <span style="height: 88%"></span>
          <span style="height: 94%"></span>
          <span style="height: 100%"></span>
        </div>
      </div>
    </div>
  </section>

</Layout>
