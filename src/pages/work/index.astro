---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('work')).sort((a, b) => {
  const da = a.data.pubDate?.valueOf() ?? 0;
  const db = b.data.pubDate?.valueOf() ?? 0;
  return db - da;
});

const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long' }) : '';
---

<Layout title="Work — Nicolle Weeks" description="Selected case studies in content design, conversational UX, and design systems.">
  <nav class="nav nav--solid">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <rect x="4" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="11" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="18" y="6" width="3" height="20" fill="#FFB3D2" />
          <rect x="25" y="6" width="3" height="20" fill="#FFB3D2" />
        </svg>
      </span>
      <span>Nicolle<br />Weeks</span>
    </a>
    <div class="nav-right">
      <a href="/work/" class="nav-link">Work</a>
      <a href="/writing/" class="nav-link">Writing</a>
      <a href="/#contact" class="btn btn-yellow">Let's collaborate</a>
    </div>
  </nav>

  <header class="writing-header">
    <div class="wrap">
      <h1>Work</h1>
      <p>Selected case studies — content design, conversational UX, and the systems behind them.</p>
    </div>
  </header>

  <section class="writing-list">
    <div class="wrap">
      <ul>
        {projects.map((p) => (
          <li>
            <a href={`/work/${p.slug}/`}>
              {p.data.heroImage ? (
                <img class="writing-thumb" src={p.data.heroImage} alt="" loading="lazy" />
              ) : (
                <span class="writing-thumb writing-thumb--empty" aria-hidden="true"></span>
              )}
              <div class="writing-meta">
                <time>{fmt(p.data.pubDate)}</time>
                <h2>{p.data.title}</h2>
                {p.data.description && <p>{p.data.description}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
